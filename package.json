{
  "name": "bb-rpiv-todo-renderer",
  "version": "0.1.2",
  "description": "Projects Pi's @juicesharp/rpiv-todo list into BB's native composer to-do panel.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhenHuangLab/bb-rpiv-todo-renderer.git"
  },
  "homepage": "https://github.com/ZhenHuangLab/bb-rpiv-todo-renderer",
  "bugs": {
    "url": "https://github.com/ZhenHuangLab/bb-rpiv-todo-renderer/issues"
  },
  "engines": {
    "bb": ">=0.38",
    "bbPluginSdk": ">=0.4.6"
  },
  "bb": {
    "name": "RPIV Todo",
